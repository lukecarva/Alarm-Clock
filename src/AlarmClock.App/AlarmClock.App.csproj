<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AlarmClock.Core\AlarmClock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Só para System.Windows.Forms.Screen: enumerar monitores e áreas de
         trabalho. Escrever isso à mão com EnumDisplayMonitors seria muito mais
         código para o mesmo resultado. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DespertadorProdutivo</AssemblyName>
    <RootNamespace>AlarmClock.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness (PerMonitorV2) for sharp alerts on mixed-scale
         multi-monitor setups. | Reconhecimento de DPI por monitor (PerMonitorV2)
         para alertas nítidos em multi-monitor com escalas diferentes. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 pede configurar DPI pela API do WinForms; este é um app WPF que só
         usa WinForms para enumerar telas (sem loop de mensagens), então o manifesto
         é o único mecanismo que vale. | WFAC010 asks to set DPI via the WinForms API;
         this is a WPF app that uses WinForms only to enumerate screens (no message
         loop), so the manifest is the mechanism that actually applies. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!-- Ajustes de peso em execução. Um utilitário de bandeja quer o menor
       working set possível, não vazão máxima. -->
  <PropertyGroup>
    <!-- GC de estação, não de servidor: um heap só, sem uma thread de GC por
         núcleo. Para um app pequeno e sempre aberto, é bem menos memória. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Sem GC concorrente: dispensa a thread de background e o heap extra que
         ela reserva. As pausas de GC são irrelevantes num despertador. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Devolve memória ao SO em vez de segurar para reuso — troca um pouco de
         velocidade de realocação por um working set menor em repouso. -->
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Precisa ser Resource (e não só ApplicationIcon) para o pack:// URI do
         ícone da bandeja resolver em tempo de execução. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms joga System.Windows.Forms nos implicit usings, e aí
         Application, MessageBox e afins ficam ambíguos com os do WPF. Os poucos
         tipos do WinForms que usamos (Screen) são qualificados na mão. -->
    <Using Remove="System.Windows.Forms" />
    <!-- Mesmo motivo: System.Drawing.Brush/Color/Point colidem com os do WPF. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
