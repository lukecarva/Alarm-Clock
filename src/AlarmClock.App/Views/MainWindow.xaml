<Window x:Class="AlarmClock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Despertador Produtivo"
        Height="600" Width="760"
        MinHeight="460" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Title}" Text="Despertador Produtivo" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="{Binding NextAlarmSummary}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Primary}"
                    VerticalAlignment="Center"
                    Content="Novo alarme"
                    Command="{Binding NewAlarmCommand}" />
        </Grid>

        <!-- Lista -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Alarms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Barra da cor da urgência -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           RadiusX="2" RadiusY="2"
                                           Fill="{Binding AccentBrush}"
                                           Margin="0,0,14,0" />

                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource Chip.Toggle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"
                                              MinWidth="52"
                                              Content="Ativo"
                                              IsChecked="{Binding IsEnabled}" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ScheduleText}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="  ·  " />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding UrgencyName}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="  ·  " />
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   Foreground="{Binding AccentBrush}"
                                                   Text="{Binding NextText}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Content="Editar"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Content="Excluir"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vazio -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAlarms}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430">
                <Ellipse Width="52" Height="52" Fill="{StaticResource Brush.Accent}" Opacity="0.16"
                         HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Body}"
                           Margin="0,18,0,0" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                           Text="Nenhum alarme ainda" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Margin="0,8,0,0" TextAlignment="Center"
                           Text="Crie o primeiro e escolha o nível de urgência. Sussurro é um toast silencioso; Crítico cobre a tela inteira e só sai com uma ação deliberada." />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Margin="0,14,0,0" TextAlignment="Center"
                           Text="Fechar esta janela não encerra o app. Ele continua na bandeja." />
            </StackPanel>
        </Border>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DataFolder, StringFormat='Dados e logs: {0}'}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0" Text="{Binding Version, StringFormat='versão {0}'}" />
            </StackPanel>

            <ToggleButton Grid.Column="1"
                          Style="{StaticResource Chip.Toggle}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Content="Iniciar com o Windows"
                          IsChecked="{Binding StartWithWindows}" />

            <Button Grid.Column="2"
                    Style="{StaticResource Button.Ghost}"
                    Content="Abrir pasta de dados"
                    Command="{Binding OpenDataFolderCommand}" />
        </Grid>
    </Grid>
</Window>
