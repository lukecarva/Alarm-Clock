<Window x:Class="AlarmClock.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AlarmClock.App.Localization"
        Title="{loc:Loc Alert_WindowTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}">

    <!-- Covers a secondary monitor during a critical alert; controls stay on the main screen. | Cobre um monitor secundário num alerta crítico; os controles ficam na tela principal. -->
    <Border BorderBrush="{Binding AccentBrush}" BorderThickness="0,5,0,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding NowText}"
                       FontFamily="{StaticResource Font.Ui}"
                       FontSize="86"
                       FontWeight="Light"
                       Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource Text.Title}"
                       FontSize="40"
                       Margin="0,12,0,0"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Margin="0,14,0,0"
                       TextAlignment="Center"
                       Text="{loc:Loc Alert_UseMainScreen}" />
        </StackPanel>
    </Border>
</Window>
